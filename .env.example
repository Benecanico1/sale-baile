# Variables de Entorno - Bachata Hoy / Bachata Cerca
# Copiar este archivo como .env para desarrollo local o configurar en el proveedor de hosting (Vercel, Netlify, etc.)

# Supabase (Opcional en modo demo local, requerido para base de datos en la nube)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=818466285375-mfrk0dt2luuipul7atiu8397j5r4bk6a.apps.googleusercontent.com

# Gemini AI (Vision API para analisis de flyers de eventos)
VITE_GEMINI_API_KEY=tu_gemini_api_key

# Apify (Scraper de Instagram)
VITE_APIFY_TOKEN=tu_apify_token

# Configuracion de la App
VITE_APP_NAME="Bachata Hoy"
VITE_DEFAULT_COUNTRY="Argentina"
VITE_DEFAULT_TIMEZONE="America/Argentina/Buenos_Aires"
