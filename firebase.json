{
  "hosting": [
    {
      "site": "salebaile",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.bin",
        "**/*.apk"
      ],
      "headers": [
        {
          "source": "**/sale-baile.bin",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/vnd.android.package-archive"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"SaleBaile.apk\""
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "hoy-bailamos-app",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.bin",
        "**/*.apk"
      ],
      "headers": [
        {
          "source": "**/sale-baile.bin",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/vnd.android.package-archive"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"SaleBaile.apk\""
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  }
}